* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f1f3f6;
    color: #000000;
}

header {
    background: linear-gradient(135deg, #1f14be, #2563eb);
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
}

main {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px;
}

.perfil {
    background: white;
    border-radius: 20px;
    padding: 30px;
    display: flex;
    align-items: center;
    gap: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.perfil img {
    width: 400px;
    height: 400px;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid #27217a;
}

.informacoes h2 {
    font-size: 30px;
    margin-bottom: 20px;
    color: #2123b6;
}

.informacoes p {
    margin: 10px 0;
    font-size: 17px;
}

button {
    margin-top: 20px;
    padding: 13px 25px;
    border: none;
    border-radius: 10px;
    background: #043cb4;
    color: white;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #2563eb;
    transform: scale(1.05);
}

.historia {
    background: white;
    margin-top: 30px;
    padding: 35px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.historia h2 {
    color: #0b08b8;
    margin: 25px 0 10px;
}

.historia h2:first-child {
    margin-top: 0;
}

.historia p {
    line-height: 1.7;
    font-size: 17px;
}

.historia ul {
    margin: 15px 0 0 25px;
    line-height: 2;
}

.curiosidades {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 20px;
}

.curiosidades div {
    background: #f1f3f6;
    padding: 18px;
    border-radius: 10px;
}

.escondido {
    display: none;
}

footer {
    margin-top: 50px;
    padding: 25px;
    text-align: center;
    background: #111827;
    color: white;
}


/* RESPONSIVIDADE */

@media (max-width: 700px) {

    .perfil {
        flex-direction: column;
        text-align: center;
    }

    .perfil img {
        width: 200px;
        height: 200px;
    }

    header h1 {
        font-size: 28px;
    }

    .curiosidades {
        grid-template-columns: 1fr;
    }
}

